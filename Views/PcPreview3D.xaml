<UserControl x:Class="Come.Views.PcPreview3D"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             Background="Transparent">
    <Grid Background="#050D18">
        <hx:Viewport3DX x:Name="View3D"
                       Camera="{Binding Camera3D, ElementName=Root}"
                       EffectsManager="{Binding EffectsManager, ElementName=Root}"
                       BackgroundColor="#050D18"
                       EnableSwapChainRendering="False"
                       FXAALevel="Low"
                       IsInertiaEnabled="True"
                       IsPinchZoomEnabled="True"
                       IsTouchRotateEnabled="True"
                       IsZoomEnabled="True"
                       IsRotationEnabled="True"
                       FixedRotationPoint="0,0,0"
                       FixedRotationPointEnabled="True">
            <hx:Viewport3DX.InputBindings>
                <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="LeftClick" />
                <MouseBinding Command="hx:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="RightClick" />
            </hx:Viewport3DX.InputBindings>
            <hx:AmbientLight3D Color="#687487" />
            <hx:DirectionalLight3D Direction="-1,-2,-3" Color="#F1F6FF" />
            <hx:DirectionalLight3D Direction="2,1,1" Color="#748DFF" />
            <hx:DirectionalLight3D Direction="0,-1,2" Color="#50D7C2" />
            <hx:Element3DPresenter Content="{Binding GroupModel, ElementName=Root}" />
        </hx:Viewport3DX>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#D00B1726" CornerRadius="13" Padding="14,10" BorderBrush="#304860" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="REAL-TIME 3D" Style="{StaticResource EyebrowText}" FontSize="10" />
                </StackPanel>
                <TextBlock Text="좌우 드래그 회전 · 휠 확대" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
            <Button Content="초기화" Click="Reset_Click" Style="{StaticResource GhostButton}" MinHeight="42" Padding="14,8" FontSize="12" Margin="0,0,8,0" />
            <Button x:Name="ExplodeButton" Content="분해 보기" Click="Explode_Click" Style="{StaticResource GhostButton}" MinHeight="42" Padding="14,8" FontSize="12" />
        </StackPanel>

        <Border x:Name="LoadingOverlay" Background="#9A050D18">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="170" Height="4" IsIndeterminate="True" Foreground="{StaticResource MintBrush}" Background="#26384B" BorderThickness="0" />
                <TextBlock Text="실제 부품 모델 불러오는 중" Foreground="#A8B8C8" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" CornerRadius="18" Background="#C00B1726" BorderBrush="#263C55" BorderThickness="1" Padding="16,8">
            <TextBlock x:Name="RenderStatusText" Text="GLB 고정밀 메시 · PBR 재질 · 실물 형상" Foreground="#7890A7" FontSize="10" />
        </Border>
    </Grid>
</UserControl>
