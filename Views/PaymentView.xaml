<UserControl x:Class="Come.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource InkBrush}" Margin="90,36,90,46">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="0.7*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="38">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="PAYMENT METHOD" Style="{StaticResource EyebrowText}" /><TextBlock Text="결제 수단을 선택해 주세요" FontSize="28" FontWeight="Bold" Margin="0,8,0,7" /><TextBlock Text="결제 정보는 기기에 저장되지 않습니다." Style="{StaticResource MutedText}" /></StackPanel>
                <Grid Grid.Row="1" Margin="0,34,0,28">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="신용카드" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsEnabled="{Binding IsNotPaying}">
                        <Border Style="{StaticResource CardBorder}" Background="#182C4370" BorderBrush="#775D7CFF" Padding="28"><StackPanel VerticalAlignment="Center"><Border Width="78" Height="58" CornerRadius="15" Background="#235D7CFF" HorizontalAlignment="Left"><TextBlock Text="▰" Foreground="#90A5FF" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="신용 · 체크카드" FontSize="21" FontWeight="Bold" Margin="0,25,0,8" /><TextBlock Text="IC 카드 리더기" Style="{StaticResource MutedText}" /><TextBlock Text="VISA  ·  mastercard  ·  국내카드" Foreground="#607890" FontSize="10" Margin="0,24,0,0" /></StackPanel></Border>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="QR 간편결제" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsEnabled="{Binding IsNotPaying}">
                        <Border Style="{StaticResource CardBorder}" Padding="28"><StackPanel VerticalAlignment="Center"><Border Width="78" Height="58" CornerRadius="15" Background="#2048E0C2" HorizontalAlignment="Left"><TextBlock Text="▦" Foreground="{StaticResource MintBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="QR 간편결제" FontSize="21" FontWeight="Bold" Margin="0,25,0,8" /><TextBlock Text="휴대폰으로 스캔" Style="{StaticResource MutedText}" /><TextBlock Text="카카오페이  ·  네이버페이" Foreground="#607890" FontSize="10" Margin="0,24,0,0" /></StackPanel></Border>
                    </Button>
                </Grid>
                <Border Grid.Row="2" Background="#0B1727" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                    <Grid><StackPanel><TextBlock Text="현재 상태" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding PaymentStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel><ProgressBar IsIndeterminate="True" Width="160" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MintBrush}" Visibility="{Binding IsPaying, Converter={StaticResource BoolToVisibility}}" /></Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBorder}" Padding="30">
                <StackPanel>
                    <TextBlock Text="TOTAL" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="최종 결제 금액" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,4" />
                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}원}" FontSize="36" FontWeight="Bold" />
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20" />
                    <Grid Margin="0,5"><TextBlock Text="받는 분" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding CustomerName}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,7"><TextBlock Text="연락처" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding PhoneNumber}" HorizontalAlignment="Right" /></Grid>
                    <TextBlock Text="{Binding Address}" TextWrapping="Wrap" Foreground="#C4D0DC" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding AddressDetail}" TextWrapping="Wrap" Foreground="#8095A9" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <Button Content="결제 승인 요청" Command="{Binding PayCommand}" IsEnabled="{Binding IsNotPaying}" Style="{StaticResource MintButton}" FontSize="18" MinHeight="64" Margin="0,20,0,12" />
            <Button Content="←  배송 정보로 돌아가기" Command="{Binding BackCommand}" IsEnabled="{Binding IsNotPaying}" Style="{StaticResource GhostButton}" />
            <TextBlock Text="결제 버튼을 누르면 주문 내용과 결제 금액에 동의한 것으로 봅니다." Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="12,14" />
        </StackPanel>
    </Grid>
</UserControl>
