<UserControl x:Class="Come.Views.CompleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource InkBrush}" ClipToBounds="True">
        <Ellipse Width="900" Height="900" Fill="#0F48E0C2" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Effect><BlurEffect Radius="80" /></Ellipse.Effect></Ellipse>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="680">
            <Border Width="112" Height="112" CornerRadius="56" Background="#2348E0C2" BorderBrush="#8848E0C2" BorderThickness="2" HorizontalAlignment="Center">
                <TextBlock Text="✓" Foreground="{StaticResource MintBrush}" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="주문이 완료되었습니다" FontSize="43" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,28,0,10" />
            <TextBlock Text="선택하신 구성으로 꼼꼼하게 조립한 뒤 안전하게 보내드릴게요." Foreground="{StaticResource MutedBrush}" FontSize="17" HorizontalAlignment="Center" />

            <Border Style="{StaticResource CardBorder}" Padding="28" Margin="0,34,0,26">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="주문 번호" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding Receipt.OrderNumber}" FontSize="17" FontWeight="Bold" Margin="0,7,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="결제 금액" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}원}" FontSize="17" FontWeight="Bold" Margin="0,7,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="배송 예정" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="결제 후 3~5일" FontSize="17" FontWeight="Bold" Margin="0,7,0,0" /></StackPanel>
                </Grid>
            </Border>

            <Border Background="#102C4947" BorderBrush="#4557B8AA" BorderThickness="1" CornerRadius="16" Padding="18" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="●" Foreground="{StaticResource MintBrush}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="조립 시작과 배송 출발 시 입력하신 연락처로 안내해 드립니다." Foreground="#C3D7D2" /></StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                <Button Content="영수증 출력" Style="{StaticResource GhostButton}" Margin="0,0,12,0" />
                <Button Content="새 주문 시작" Command="{Binding NewOrderCommand}" Style="{StaticResource PrimaryButton}" MinWidth="180" />
            </StackPanel>
            <TextBlock Text="이용해 주셔서 감사합니다  ·  COME CUSTOM PC STUDIO" Style="{StaticResource EyebrowText}" Foreground="#587088" HorizontalAlignment="Center" Margin="0,30,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
