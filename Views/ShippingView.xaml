<UserControl x:Class="Come.Views.ShippingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource InkBrush}" Margin="70,30,70,38">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="0.7*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="36">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="SHIPPING DETAILS" Style="{StaticResource EyebrowText}" /><TextBlock Text="어디로 보내드릴까요?" FontSize="28" FontWeight="Bold" Margin="0,8,0,7" /><TextBlock Text="주문 후 주소 변경이 어려우니 정확하게 확인해 주세요." Style="{StaticResource MutedText}" /></StackPanel>
                <Grid Grid.Row="1" Margin="0,26,0,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="받는 분" FontWeight="SemiBold" Margin="3,0,0,8" /><TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" /></StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock Text="휴대폰 번호" FontWeight="SemiBold" Margin="3,0,0,8" /><TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="13" /></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock Text="주소" FontWeight="SemiBold" Margin="3,0,0,8" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="2" Content="주소 검색" Style="{StaticResource GhostButton}" /></Grid></StackPanel>
                    <StackPanel Grid.Row="6"><TextBlock Text="상세 주소" FontWeight="SemiBold" Margin="3,0,0,8" /><TextBox Text="{Binding AddressDetail, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" /></StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="#20FF6B7D" BorderBrush="#66FF6B7D" BorderThickness="1" CornerRadius="12" Padding="14" Visibility="{Binding HasShippingError, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding ShippingError}" Foreground="#FF9BA8" /></Border>
            </Grid>
        </Border>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBorder}" Padding="28">
                <StackPanel>
                    <TextBlock Text="ORDER SUMMARY" Style="{StaticResource EyebrowText}" />
                    <Grid Margin="0,18,0,8"><TextBlock Text="선택 부품" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SelectedCount, StringFormat={}{0}개}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,7"><TextBlock Text="예상 소비전력" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding EstimatedPower, StringFormat={}{0} W}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,7"><TextBlock Text="배송비" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="무료" HorizontalAlignment="Right" Foreground="{StaticResource MintBrush}" /></Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16" />
                    <TextBlock Text="최종 결제 금액" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}원}" FontSize="31" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Background="#102F4C49" BorderBrush="#405EC6B5" Padding="20" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="#2048E0C2" CornerRadius="13"><TextBlock Text="✓" Foreground="{StaticResource MintBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="안심 조립 &amp; 포장" FontWeight="SemiBold" /><TextBlock Text="조립 완료 후 검수 결과를 안내해 드려요" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" /></StackPanel></StackPanel>
            </Border>
            <Grid Margin="0,22,0,0"><Button Content="←  이전" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" /><Button Content="결제 단계로  →" Command="{Binding GoPaymentCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" /></Grid>
        </StackPanel>
    </Grid>
</UserControl>
