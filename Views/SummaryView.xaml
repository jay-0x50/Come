<UserControl x:Class="Come.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Come.Views">
    <Grid Background="{StaticResource InkBrush}" Margin="40,22,40,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="26">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="SELECTED PARTS" Style="{StaticResource EyebrowText}" /><TextBlock Text="선택한 부품" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="불러오기" Command="{Binding LoadBuildCommand}" Style="{StaticResource GhostButton}" MinHeight="42" Padding="14,8" FontSize="12" Margin="0,0,8,0" /><Button Content="저장하기" Command="{Binding SaveBuildCommand}" Style="{StaticResource GhostButton}" MinHeight="42" Padding="14,8" FontSize="12" /></StackPanel></Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedParts}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Margin" Value="0,0,6,8" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0B1727" BorderBrush="#22374D" BorderThickness="1" CornerRadius="15" Padding="14,11">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#183F5871"><TextBlock Text="{Binding Glyph}" Foreground="{StaticResource MintBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="13" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Part.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Part.Manufacturer}" Foreground="#607890" FontSize="10" Margin="0,2,0,0" /></StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Part.PriceDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="변경" Command="{Binding DataContext.ChangePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" MinHeight="36" Padding="10,5" FontSize="11" Margin="0,0,5,0" /><Button Content="×" Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="36" Height="36" MinHeight="36" Padding="0" Foreground="{StaticResource ErrorBrush}" /></StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="0,16,0,0"><Button Content="←  부품 더 보기" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" /><Button Content="구성 초기화" Command="{Binding ResetBuildCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Foreground="{StaticResource ErrorBrush}" /></Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="1.15*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True"><views:PcPreview3D ItemsSource="{Binding SelectedParts}" HighDetail="True" Visibility="{Binding IsDetailOpen, Converter={StaticResource InverseBoolean}}" /></Border>
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="26">
                <StackPanel>
                    <TextBlock Text="ESTIMATE" Style="{StaticResource EyebrowText}" />
                    <Grid Margin="0,16,0,8"><TextBlock Text="상품 금액" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SupplyPrice, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,6"><TextBlock Text="부가세" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Vat, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" /></Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14" />
                    <Grid><TextBlock Text="최종 결제 금액" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}원}" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="{StaticResource MintBrush}" /></Grid>
                    <Border Background="#0CFFFFFF" CornerRadius="14" Padding="15" Margin="0,18,0,18">
                        <Grid><StackPanel><TextBlock Text="예상 소비전력" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding EstimatedPower, StringFormat={}{0} W}" FontSize="17" FontWeight="Bold" Margin="0,4,0,0" /></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="권장 파워" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" /><TextBlock Text="{Binding RecommendedPower, StringFormat={}{0} W 이상}" FontSize="17" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Right" /></StackPanel></Grid>
                    </Border>
                    <Button Content="배송 정보 입력  →" Command="{Binding GoShippingCommand}" IsEnabled="{Binding CanCheckout}" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="{Binding CheckoutHint}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
