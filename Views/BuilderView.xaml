<UserControl x:Class="Come.Views.BuilderView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Come.Views">
    <Grid Background="{StaticResource InkBrush}" Margin="28,18,28,16">
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="빠른 필터" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ItemsControl ItemsSource="{Binding PopularTags}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding StringFormat=\#{0}}" Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ChipButton}" Margin="0,0,8,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ActiveTags}" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ChipButton}" Background="#2948E0C2" BorderBrush="#8848E0C2" Margin="0,0,8,0">
                                <TextBlock><Run Text="#" /><Run Text="{Binding}" /><Run Text="  ×" /></TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Command="{Binding SyncCatalogCommand}" Style="{StaticResource GhostButton}" MinHeight="40" Padding="13,7" Margin="0,0,10,0" ToolTip="실제 제품 데이터 다시 불러오기">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding CatalogStatus}" FontSize="10" /></StackPanel>
                </Button>
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Width="150" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.2*" MinWidth="500" /><ColumnDefinition Width="18" /><ColumnDefinition Width="0.95*" MinWidth="390" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="10,10,10,14">
                        <TextBlock Text="COMPONENTS" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="부품 카테고리" FontSize="20" FontWeight="Bold" Margin="0,7,0,0" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="13" Padding="12,10"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#245D7CFF" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#142B405A" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="10" Background="#142D435A"><TextBlock Text="{Binding Glyph}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding EnglishName}" Foreground="#627991" FontSize="9" /></StackPanel></Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Margin="4,12,4,2" CornerRadius="14" Background="#0BFFFFFF" Padding="14">
                        <StackPanel><TextBlock Text="진행 현황" Style="{StaticResource MutedText}" FontSize="12" /><Grid Margin="0,7,0,0"><TextBlock Text="선택한 부품" FontSize="13" /><TextBlock Text="{Binding SelectedCountText}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource MintBrush}" /></Grid></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="2,0,2,14">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="제품 " FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding ResultCount}" Foreground="{StaticResource MintBrush}" FontWeight="Bold" /><TextBlock Text="개" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                    <Button Content="필터 초기화" Command="{Binding ClearSearchCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" MinHeight="40" Padding="14,7" FontSize="12" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredParts}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,8,10" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="18" CornerRadius="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Border Width="70" Height="70" CornerRadius="18" Background="{Binding Accent}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Glyph}" Foreground="#F8FFFFFF" FontWeight="Black" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Manufacturer}" Foreground="{StaticResource MintBrush}" FontSize="10" FontWeight="Bold" />
                                            <Border HorizontalAlignment="Right" Background="#173D5972" BorderBrush="#365873" BorderThickness="1" CornerRadius="8" Padding="7,3"><TextBlock Text="{Binding SourceBadge}" Foreground="#8FA9C0" FontSize="8" FontWeight="Bold" /></Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,5,0,5" />
                                        <TextBlock Text="{Binding SpecSummary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,9,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Background="#102E4359" CornerRadius="8" Padding="7,3" Margin="0,0,5,0"><TextBlock Text="{Binding StringFormat=\#{0}}" Foreground="#8EA3B8" FontSize="9" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceDisplay}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StockDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="상세" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" MinHeight="38" Padding="12,6" FontSize="12" Margin="0,0,6,0" />
                                            <Button Content="{Binding SelectionActionText}" Command="{Binding DataContext.AddPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MintButton}" MinHeight="38" Padding="14,6" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="1.1*" /><RowDefinition Height="Auto" /><RowDefinition Height="0.75*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <views:PcPreview3D ItemsSource="{Binding SelectedParts}" Visibility="{Binding IsDetailOpen, Converter={StaticResource InverseBoolean}}" />
                    <Border Grid.Row="1" Height="1" Background="{StaticResource LineBrush}" />
                    <Grid Grid.Row="2" Margin="20,14,16,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="현재 구성" FontWeight="Bold" FontSize="16" /><Border Background="#245D7CFF" CornerRadius="10" Padding="8,3" Margin="9,-2,0,0"><TextBlock Text="{Binding SelectedCountText}" Foreground="#AEBEFF" FontSize="10" FontWeight="Bold" /></Border></StackPanel><TextBlock Text="{Binding EstimatedPower, StringFormat=예상 {0}W}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedParts}" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid Height="34"><Border Width="28" Height="28" Background="#183F5871" CornerRadius="8" HorizontalAlignment="Left"><TextBlock Text="{Binding Glyph}" FontSize="8" Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding Part.Name}" Margin="38,0,100,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Part.PriceDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Border Grid.Row="3" Background="#07111F" Padding="20,14">
                        <Grid><StackPanel><TextBlock Text="합계" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}원}" FontSize="22" FontWeight="Bold" /></StackPanel><Button Content="견적 확인  →" Command="{Binding GoSummaryCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="20,11" MinHeight="50" /></Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
