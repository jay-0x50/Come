<Window x:Class="Come.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Come.Views"
        xmlns:vm="clr-namespace:Come.ViewModels"
        Title="COME · Custom PC Studio"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource InkBrush}"
        MinWidth="1280"
        MinHeight="720">
    <Window.Resources>
        <DataTemplate x:Key="AttractTemplate"><views:AttractView /></DataTemplate>
        <DataTemplate x:Key="HomeTemplate"><views:HomeView /></DataTemplate>
        <DataTemplate x:Key="CompleteTemplate"><views:CompleteView /></DataTemplate>
        <DataTemplate x:Key="BuilderTemplate"><views:BuilderView /></DataTemplate>
        <DataTemplate x:Key="SummaryTemplate"><views:SummaryView /></DataTemplate>
        <DataTemplate x:Key="ShippingTemplate"><views:ShippingView /></DataTemplate>
        <DataTemplate x:Key="PaymentTemplate"><views:PaymentView /></DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource InkBrush}">
        <ContentControl Content="{Binding}" Visibility="{Binding IsChromeVisible, Converter={StaticResource InverseBoolean}}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource AttractTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Home}"><Setter Property="ContentTemplate" Value="{StaticResource HomeTemplate}" /></DataTrigger>
                        <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Complete}"><Setter Property="ContentTemplate" Value="{StaticResource CompleteTemplate}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <Grid Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="104" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A1625" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="62" /><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="43" Height="43" CornerRadius="13" Background="{StaticResource MintBrush}"><TextBlock Text="C" Foreground="#071A20" FontWeight="Black" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Margin="12,1,0,0"><TextBlock Text="C O M E" FontSize="18" FontWeight="Bold" /><TextBlock Text="CUSTOM PC" FontSize="8" Foreground="#667D93" /></StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="←" Command="{Binding BackCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="23" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0">
                        <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PageCaption}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="3" Margin="8,23" Background="#0D1A2B" BorderBrush="#2B4058" BorderThickness="1" CornerRadius="15">
                        <Grid><TextBlock Text="⌕" Foreground="{StaticResource MintBrush}" FontSize="27" Margin="16,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="52,0,45,0" MinHeight="0" FontSize="15" VerticalContentAlignment="Center" /><Button Content="×" Command="{Binding ClearSearchCommand}" Style="{StaticResource IconButton}" Width="40" Height="40" MinHeight="40" HorizontalAlignment="Right" Margin="0,0,7,0" Background="Transparent" BorderThickness="0" Foreground="#71869A" /></Grid>
                    </Border>
                    <Grid Grid.Column="4" Margin="25,0,18,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"><Ellipse Width="32" Height="32" Fill="#245D7CFF" Stroke="#6F83FF" /><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /><TextBlock Text="조립" HorizontalAlignment="Center" Margin="0,42,0,0" FontSize="9" Foreground="#71869A" /></Grid>
                        <Border Grid.Column="1" Height="2" Background="#33465C" />
                        <Grid Grid.Column="2"><Ellipse Width="32" Height="32" Fill="#142438" Stroke="#334B65"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Stroke" Value="#334B65" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Fill" Value="#245D7CFF" /><Setter Property="Stroke" Value="#6F83FF" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /><TextBlock Text="견적" HorizontalAlignment="Center" Margin="0,42,0,0" FontSize="9" Foreground="#71869A" /></Grid>
                        <Border Grid.Column="3" Height="2" Background="#33465C" />
                        <Grid Grid.Column="4"><Ellipse Width="32" Height="32" Fill="#142438" Stroke="#334B65"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Stroke" Value="#334B65" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Fill" Value="#245D7CFF" /><Setter Property="Stroke" Value="#6F83FF" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /><TextBlock Text="배송" HorizontalAlignment="Center" Margin="0,42,0,0" FontSize="9" Foreground="#71869A" /></Grid>
                        <Border Grid.Column="5" Height="2" Background="#33465C" />
                        <Grid Grid.Column="6"><Ellipse Width="32" Height="32" Fill="#142438" Stroke="#334B65"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Stroke" Value="#334B65" /><Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Fill" Value="#245D7CFF" /><Setter Property="Stroke" Value="#6F83FF" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /><TextBlock Text="결제" HorizontalAlignment="Center" Margin="0,42,0,0" FontSize="9" Foreground="#71869A" /></Grid>
                    </Grid>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="현재 견적" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" /><TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}원}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0" /></StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource BuilderTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Summary}"><Setter Property="ContentTemplate" Value="{StaticResource SummaryTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Shipping}"><Setter Property="ContentTemplate" Value="{StaticResource ShippingTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Payment}"><Setter Property="ContentTemplate" Value="{StaticResource PaymentTemplate}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Border Grid.Row="2" Background="#0A1625" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="32,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#2048E0C2" Margin="0,0,13,0"><TextBlock Text="✓" Foreground="{StaticResource MintBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel><TextBlock Text="{Binding CompatibilityHeadline}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding CompatibilityDetail}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="선택" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding SelectedCountText}" FontWeight="Bold" Foreground="{StaticResource MintBrush}" VerticalAlignment="Center" Margin="8,0,26,0" />
                        <TextBlock Text="예상 소비전력" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding EstimatedPower, StringFormat={}{0} W}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#B9000712" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <Button Command="{Binding CloseDetailCommand}" Background="Transparent" BorderThickness="0" />
            <Border Width="790" MaxHeight="760" Background="#101E31" BorderBrush="#3B536D" BorderThickness="1" CornerRadius="26" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.65" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Border Width="92" Height="92" CornerRadius="24" Background="{Binding DetailPart.Accent}" HorizontalAlignment="Left"><TextBlock Text="{Binding DetailPart.Glyph}" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Margin="116,5,70,0"><TextBlock Text="{Binding DetailPart.Manufacturer}" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding DetailPart.Name}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,6" /><TextBlock Text="{Binding DetailPart.DetailSummary}" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" /></StackPanel>
                        <Button Content="×" Command="{Binding CloseDetailCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="24" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding DetailPart.Tags}" Margin="116,16,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#183F5871" CornerRadius="9" Padding="9,4" Margin="0,0,6,0"><TextBlock Text="{Binding StringFormat=\#{0}}" Foreground="#9EB1C4" FontSize="10" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Border Grid.Row="2" Background="#0A1625" CornerRadius="18" Padding="22" Margin="0,26,0,22">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,22,0"><TextBlock Text="SPECIFICATIONS" Style="{StaticResource EyebrowText}" Margin="0,0,0,13" /><ItemsControl ItemsSource="{Binding DetailPart.Specifications}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><TextBlock Text="{Binding Key}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource LineBrush}" />
                            <StackPanel Grid.Column="2" Margin="24,0,0,0"><TextBlock Text="PRICE &amp; STOCK" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding DetailPart.PriceDisplay}" FontSize="30" FontWeight="Bold" Margin="0,18,0,6" /><TextBlock Text="{Binding DetailPart.StockDisplay}" Foreground="{StaticResource MintBrush}" /><Border Background="#102C4947" CornerRadius="12" Padding="13" Margin="0,18,0,0"><StackPanel><TextBlock Text="{Binding DetailPart.SourceBadge}" FontWeight="SemiBold" /><TextBlock Text="{Binding DetailPart.VerificationDisplay}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel></Border></StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3"><Button Content="닫기" Command="{Binding CloseDetailCommand}" Style="{StaticResource GhostButton}" Width="120" HorizontalAlignment="Left" /><Button Content="{Binding DetailPart.SelectionActionText}" Command="{Binding ConfirmDetailCommand}" Style="{StaticResource MintButton}" Width="210" HorizontalAlignment="Right" /></Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Background="#F31A2B40" BorderBrush="#485E77" BorderThickness="1" CornerRadius="16" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,92" Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.5" /></Border.Effect>
            <StackPanel Orientation="Horizontal"><TextBlock Text="✓" Foreground="{StaticResource MintBrush}" FontWeight="Bold" Margin="0,0,12,0" /><TextBlock Text="{Binding ToastMessage}" FontWeight="SemiBold" /></StackPanel>
        </Border>
    </Grid>
</Window>
